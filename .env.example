# Local default: a SQLite file created on first request (no setup needed).
DATABASE_URL=file:./data/app.db

# Production (Vercel): point at a free Turso database instead.
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Used to sign the session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
